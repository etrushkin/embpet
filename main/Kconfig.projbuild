menu "embpet"

    config EMBPET_PENDING_MAX
        int "Maximum pending Telegram messages"
        default 64
        range 1 256
        help
            Size of the RAM-only pending (unanswered) table, README 2.1.

    config EMBPET_EVT_RING
        int "Event ring size (events kept for replay)"
        default 32
        range 1 1024
        help
            Number of recent evt frames kept for replay, README 3.3.

    config EMBPET_PULSE_DEFAULT_MS
        int "Default output pulse length (ms)"
        default 100
        range 1 EMBPET_PULSE_MAX_MS
        help
            Pulse length used by io pulse without -d, README 2.4.

    config EMBPET_PULSE_MAX_MS
        int "Maximum output pulse length (ms)"
        default 600000
        range 1 86400000
        help
            Upper bound for io pulse -d, README 2.4.

    config EMBPET_DEBOUNCE_DEFAULT_MS
        int "Default input debounce time (ms)"
        default 20
        range 0 1000
        help
            Debounce time for inputs without a stored value, README 2.3.

    config EMBPET_TG_POLL_TIMEOUT_S
        int "Telegram getUpdates long-poll timeout (s)"
        default 50
        range 1 300
        help
            Long-poll timeout of the getUpdates request, README 2.1.

    config EMBPET_TG_SEND_TIMEOUT_MS
        int "Telegram sendMessage timeout (ms)"
        default 10000
        range 1000 120000
        help
            Timeout of the send connection to the Bot API, README 2.1.

    config EMBPET_MAX_TEXT_BYTES
        int "Maximum message text size (bytes)"
        default 4096
        range 1 8192
        help
            Longest outgoing message text, UTF-8 bytes; longer text is rejected
            with too_long, README 2.1.

    config EMBPET_CMDLINE_MAX
        int "Maximum serial CLI line length (bytes)"
        default 4400
        range 64 16384
        help
            Maximum esp_console command line, README 3.1.

    config EMBPET_WIFI_TXPOWER_QDBM
        int "Wi-Fi TX power in quarter-dBm (34 = 8.5 dBm)"
        default 34
        range 8 80
        help
            Default Wi-Fi TX power, 8 to 80 (2 to 20 dBm), README 1.3 and 3.4.

    config EMBPET_LED_GPIO
        int "Status LED GPIO"
        default 8
        range 0 21
        help
            GPIO of the status LED, README 2.2. Do not use the reserved pins
            GPIO9 (BOOT button) or GPIO18/19 (USB), README 1.2.

    config EMBPET_LED_ACTIVE_LOW
        bool "Status LED is active low"
        default y
        help
            The onboard LED is assumed active low, README 1.2 and 2.2.

endmenu
