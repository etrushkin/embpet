# sdkconfig is not committed; this file is the source of truth.
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# USB-Serial/JTAG is the only log sink (2nd-stage bootloader and app); UART0 is never a console.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# The input ISR (components/io/io_in.c) calls esp_timer_restart/start_once/is_active, which
# must stay in IRAM-safe code.
CONFIG_ESP_TIMER_IN_IRAM=y

# Pulse ends and debounce expiry are dispatched from the esp_timer interrupt (ESP_TIMER_ISR),
# so they stay on time while the Wi-Fi driver task computes WPA3-SAE (embpet-jk5.1). Those
# callbacks and the input ISR also run with the flash cache off, so gpio_set_level and
# gpio_get_level must be in IRAM.
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
