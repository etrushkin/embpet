menu "embpet io"

    # Always on (no prompt). Pulse ends and debounce expiry are dispatched from the
    # esp_timer interrupt (ESP_TIMER_ISR), so they stay on time while the Wi-Fi driver task
    # computes WPA3-SAE (embpet-jk5.1). Those callbacks and the input ISR also run with the
    # flash cache off, so the esp_timer calls of the input ISR (restart, start_once,
    # is_active) and gpio_set_level / gpio_get_level must be in IRAM. Selecting the IDF
    # options here, not in sdkconfig.defaults, also turns them on in build dirs whose
    # sdkconfig predates them (embpet-jk5.3).
    config EMBPET_IO_ISR_TIMERS
        bool
        default y
        select ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD
        select ESP_TIMER_IN_IRAM
        select GPIO_CTRL_FUNC_IN_IRAM

    config EMBPET_IO_TEST
        bool "On-chip GPIO test hooks (never enable in production)"
        default n
        help
            Compiles in test-only code: the outputs become INPUT_OUTPUT and an
            any-edge ISR timestamps their edges (`io test`), so the pulse
            length can be measured on the chip itself. Used by
            tools/io_test.py.

    config EMBPET_LED_TEST
        bool "On-chip status LED test hooks (never enable in production)"
        default n
        help
            Compiles in test-only code: the LED pin becomes INPUT_OUTPUT and an
            any-edge ISR timestamps its edges (`led t_edges`), so the pattern
            can be measured on the chip. Used by tools/led_test.py.

endmenu
